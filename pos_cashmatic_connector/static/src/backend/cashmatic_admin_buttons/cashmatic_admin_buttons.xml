<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="pos_cashmatic_connector.CashmaticAdminButtons">
        <p>
            <b>Current Cashmatic status: </b>
            <t t-esc="status" />
        </p>
        <div class="d-flex gap-2 mt-3">
            <button
                type="button"
                class="btn btn-primary"
                t-on-click.stop="resetCashMachine"
                t-att-disabled="state.resetInProgress"
            >
                Check Cashmatic
            </button>
            <button
                type="button"
                class="btn btn-secondary"
                t-on-click.stop="downloadLogs"
            >
                Download Logs
            </button>
        </div>
    </t>

</templates>
