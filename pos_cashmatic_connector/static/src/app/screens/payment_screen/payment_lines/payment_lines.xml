<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('electronic_payment')]" position="after">
            <div
                t-if="line.payment_method_id.payment_method_type === 'cashmatic'"
                class="d-flex flex-column gap-3"
            >
                <t
                    t-set="cashmatic"
                    t-value="line.payment_method_id.payment_terminal"
                />

                <div class="d-flex gap-2 mt-3 fs-4">
                    <strong>Cashmatic status:</strong>
                    <t t-out="cashmatic.status" />
                </div>

                <t
                    t-set="emptyDenominations"
                    t-value="cashmatic.getDenominationsWithStatus('EMPTY')"
                />
                <t
                    t-set="fullDenominations"
                    t-value="cashmatic.getDenominationsWithStatus('FULL')"
                />
                <t
                    t-set="nearEmptyDenominations"
                    t-value="cashmatic.getDenominationsWithStatus('NEAR_EMPTY')"
                />
                <t
                    t-set="nearFullDenominations"
                    t-value="cashmatic.getDenominationsWithStatus('NEAR_FULL')"
                />

                <div class="d-flex flex-wrap gap-2">
                    <div
                        t-if="emptyDenominations.length > 0"
                        class="alert alert-danger"
                        style="width: calc(50% - 4px)"
                    >
                        Cashmatic has run out of the following coins/bills:
                        <ul class="my-1 ps-4">
                        <li
                            style="list-style-type: disc;"
                            t-foreach="emptyDenominations"
                            t-as="denomination"
                            t-key="denomination.value"
                        >
                            <t t-out="env.utils.formatCurrency(denomination.value)" />
                        </li>
                    </ul>
                    </div>

                    <div
                        t-if="fullDenominations.length > 0"
                        class="alert alert-danger"
                        style="width: calc(50% - 4px)"
                    >
                        Cashmatic must be emptied, the following coins/bills are full:
                        <ul class="my-1 ps-4">
                        <li
                            style="list-style-type: disc;"
                            t-foreach="fullDenominations"
                            t-as="denomination"
                            t-key="denomination.value"
                        >
                            <t t-out="env.utils.formatCurrency(denomination.value)" />
                            <t
                                t-if="pos.getCashier()._role === 'manager'"
                                t-out="' (' + denomination.amount + ')'"
                            />
                        </li>
                    </ul>
                    </div>

                    <div
                        t-if="nearEmptyDenominations.length > 0"
                        class="alert alert-warning"
                        style="width: calc(50% - 4px)"
                    >
                        Cashmatic is running low on the following coins/bills:
                        <ul class="my-1 ps-4">
                        <li
                            style="list-style-type: disc;"
                            t-foreach="nearEmptyDenominations"
                            t-as="denomination"
                            t-key="denomination.value"
                        >
                            <t t-out="env.utils.formatCurrency(denomination.value)" />
                            <t
                                t-if="pos.getCashier()._role === 'manager'"
                                t-out="' (' + denomination.amount + ')'"
                            />
                        </li>
                    </ul>
                    </div>

                    <div
                        t-if="nearFullDenominations.length > 0"
                        class="alert alert-warning"
                        style="width: calc(50% - 4px)"
                    >
                        Consider emptying Cashmatic, the following coins/bills are nearly full:
                        <ul class="my-1 ps-4">
                        <li
                            style="list-style-type: disc;"
                            t-foreach="nearFullDenominations"
                            t-as="denomination"
                            t-key="denomination.value"
                        >
                            <t t-out="env.utils.formatCurrency(denomination.value)" />
                            <t
                                t-if="pos.getCashier()._role === 'manager'"
                                t-out="' (' + denomination.amount + ')'"
                            />
                        </li>
                    </ul>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[contains(text(), 'Request sent')]" position="replace">
            <div class="electronic_status d-flex gap-2">
                <span class="flex-grow-1">Request sent</span>
                <t t-if="line.payment_method_id.payment_method_type === 'cashmatic'">
                    <strong>Cashmatic amount:</strong>
                    <t
                        t-out="env.utils.formatCurrency(line.payment_method_id.payment_terminal.amountInserted)"
                    />
                </t>
            </div>
        </xpath>
    </t>
</templates>
